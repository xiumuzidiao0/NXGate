# ==============================================================================
# NXGate 环境变量配置示例模板 (config.env.example)
# 请按需导出环境变量，或由 systemd EnvironmentFile 加载此文件；裸二进制不自动加载。
# 网页修改持久化于 DATA_DIR/settings.json，优先于对应初始化环境变量。
# 注意: 严禁将包含真实密码和 Token 的 config.env 提交至公共代码库！
# ==============================================================================

# ----------------- 1. Web UI 控制台配置 -----------------
# 监听地址与端口
UI_HOST=127.0.0.1
UI_PORT=8787

# Web 后台安全访问路径 (例如: enter，即访问 http://IP:8787/enter)
UI_PATH=enter

# 管理员鉴权账密
UI_USERNAME=admin
# 留空首次自动生成，保存在 DATA_DIR/ui_password.txt（0600）
UI_PASSWORD=

# ----------------- 2. 本地代理网关配置 -----------------
# 代理监听地址与默认端口 (HTTP / HTTPS CONNECT / SOCKS5 / SOCKS5 UDP)
LOCAL_PROXY_HOST=127.0.0.1
LOCAL_PROXY_PORT=7928

# 代理账密 (留空表示自动生成高强度随机凭据并持久化至 proxy_auth.txt)
LOCAL_PROXY_USER=
LOCAL_PROXY_PASS=

# 最大并发代理连接数限制 (默认 512，范围 16-4096)
LOCAL_PROXY_MAX_CONNECTIONS=512

# ----------------- 3. 节点池与发现参数 -----------------
# 首选国家过滤 (逗号分隔，大写两位 ISO 码，如 JP,US,KR,TW,HK,SG；留空表示不限制)
DISCOVERY_COUNTRIES=JP,US

# 目标维持有效节点数与单次最大扫描行数
TARGET_VALID_NODES=5
MAX_SCAN_ROWS=1000

# 节点更新拉取与健康探测周期 (单位: 秒)
FETCH_INTERVAL_SECONDS=900
CHECK_INTERVAL_SECONDS=20

# ----------------- 4. Telegram 告警机器人 (可选) -----------------
# 向 @BotFather 申请的 Bot Token
TELEGRAM_BOT_TOKEN=

# 接收告警的个人或频道 Chat ID
TELEGRAM_CHAT_ID=

# ----------------- 5. 系统路径与底层进程 -----------------
# 运行时数据与证书存储目录
DATA_DIR=data

# OpenVPN 路径与认证配置
OPENVPN_CMD=openvpn
OPENVPN_AUTH_USER=vpn
OPENVPN_AUTH_PASS=vpn

# Shared across all proxy ports; per-port LOCAL_PROXY_MAX_CONNECTIONS still applies.
# Default 1024 permits two full 512-connection ports, but bounds port-count growth.
# Active connections are not killed when this limit is lowered through settings.
LOCAL_PROXY_GLOBAL_MAX_CONNECTIONS=1024
