# ==============================================================================
# AimiliVPN 环境变量配置示例模板 (config.env.example)
# 请复制此文件为 config.env 并根据生产/测试环境按需修改。
# 注意: 严禁将包含真实密码和 Token 的 config.env 提交至公共代码库！
# ==============================================================================

# ----------------- 1. Web UI 控制台配置 -----------------
# 监听地址与端口
UI_HOST=0.0.0.0
UI_PORT=8787

# Web 后台安全访问路径 (例如: enter，即访问 http://IP:8787/enter)
UI_PATH=enter

# 管理员鉴权账密
UI_USERNAME=admin
UI_PASSWORD=YourStrongPasswordHere_ChangeMe!

# ----------------- 2. 本地代理网关配置 -----------------
# 代理监听地址与默认端口 (HTTP / HTTPS CONNECT / SOCKS5 / SOCKS5 UDP)
PROXY_HOST=0.0.0.0
PROXY_PORT=7928

# 代理账密 (留空表示跟随管理密码或免密)
PROXY_USER=
PROXY_PASS=

# 最大并发代理连接数限制 (0 为不限制)
PROXY_MAX_CONNECTIONS=0

# ----------------- 3. 节点池与发现参数 -----------------
# 首选国家过滤 (逗号分隔，大写两位 ISO 码，如 JP,US,KR,TW,HK,SG；留空表示不限制)
DISCOVERY_COUNTRIES=JP,US

# 目标维持有效节点数与单次最大扫描行数
TARGET_VALID_NODES=30
MAX_SCAN_ROWS=200

# 节点更新拉取与健康探测周期
FETCH_INTERVAL_MINUTES=30
CHECK_INTERVAL_SECONDS=15

# ----------------- 4. Telegram 告警机器人 (可选) -----------------
# 向 @BotFather 申请的 Bot Token
TELEGRAM_BOT_TOKEN=

# 接收告警的个人或频道 Chat ID
TELEGRAM_CHAT_ID=

# ----------------- 5. 系统路径与底层进程 -----------------
# 运行时数据与证书存储目录
DATA_DIR=data

# OpenVPN 路径与认证配置
OPENVPN_COMMAND=openvpn
OPENVPN_AUTH_USER=vpn
OPENVPN_AUTH_PASS=vpn
