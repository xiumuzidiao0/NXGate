[Unit]
Description=NXGate Multi-Egress Gateway Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nxgate
EnvironmentFile=-/opt/nxgate/config.env
ExecStart=/opt/nxgate/nxgate
Restart=always
RestartSec=5
LimitNOFILE=65535
LimitNPROC=65535

[Install]
WantedBy=multi-user.target
