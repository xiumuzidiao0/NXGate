#!/usr/bin/env bash
# ==============================================================================
# AimiliVPN Git Pre-Push Hook
# 在执行 git push 之前自动执行质量准入检查：
# 1. 校验版本全链路一致性 (check-version.sh)
# 2. 运行 Go 后端全量单元测试 (go test)
# 3. 运行 Web 嵌入资产与防注入安全测试 (web/embed_test)
# 4. 运行 Playwright 跨端视口 UI 回归测试 (如环境就绪)
# ==============================================================================

set -e

DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$DIR"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;36m'
PLAIN='\033[0m'
BOLD='\033[1m'

echo -e "\n${BLUE}======================================================${PLAIN}"
echo -e "${BOLD}🚀 [Pre-push] 正在执行本地推送前质量准入自检...${PLAIN}"
echo -e "${BLUE}======================================================${PLAIN}"

# 1. 检查版本一致性
echo -e "\n${YELLOW}[1/4] 检查代码库全链路版本一致性...${PLAIN}"
if [ -x "./scripts/check-version.sh" ]; then
    if ! ./scripts/check-version.sh; then
        echo -e "${RED}❌ [Pre-push 拦截] 版本不一致，请运行 ./scripts/check-version.sh --set <版本号> 进行统一！${PLAIN}"
        exit 1
    fi
else
    echo -e "${YELLOW}  -> scripts/check-version.sh 未找到或无执行权限，跳过${PLAIN}"
fi

# 2. 静态代码分析与安全审计
echo -e "${YELLOW}[2/4] 运行静态代码分析 (go vet)...${PLAIN}"
if command -v go >/dev/null 2>&1; then
    go vet ./...
    echo -e "${GREEN}  [✓] go vet 静态分析无报错${PLAIN}"
fi

# 3. 运行 Go 单元测试
echo -e "${YELLOW}[3/4] 运行 Go 后端单元与集成测试...${PLAIN}"
if command -v go >/dev/null 2>&1; then
    if ! go test -count=1 ./...; then
        echo -e "\n${RED}❌ [Pre-push 拦截] Go 单元测试未通过！请先在本地排查修复测试用例。${PLAIN}"
        echo -e "${YELLOW}💡 提示: 紧急情况下若需临时跳过本地钩子检查，可使用: git push --no-verify${PLAIN}\n"
        exit 1
    fi
    echo -e "${GREEN}  [✓] Go 单元测试 100% 通过${PLAIN}"
else
    echo -e "${YELLOW}  -> 本地未检测到 Go 环境，跳过 Go 测试${PLAIN}"
fi

# 4. 运行前端自动化测试 (如果 node/npm 可用)
echo -e "${YELLOW}[4/4] 检查前端安全审计与多端视口测试...${PLAIN}"
if command -v npm >/dev/null 2>&1 && [ -f "web/package.json" ]; then
    if npm --prefix web run test:ui >/dev/null 2>&1; then
        echo -e "${GREEN}  [✓] WebUI 4 大视口端到端测试 100% 通过${PLAIN}"
    else
        echo -e "${YELLOW}  -> 提示: Playwright 视口测试在当前环境未触发或缺少浏览器环境，CI 流水线将代为验证${PLAIN}"
    fi
fi

echo -e "\n${GREEN}======================================================${PLAIN}"
echo -e "${GREEN}🎉 [Pre-push] 本地质量自检全部通过，允许推送到远程！${PLAIN}"
echo -e "${GREEN}======================================================${PLAIN}\n"

exit 0
