#!/usr/bin/env bash
# ==============================================================================
# NXGate Git Pre-Push Hook
# Delegates all push-time quality and architecture invariant checks to
# scripts/verify.sh so local and CI expectations never drift.
# ==============================================================================

set -euo pipefail

DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$DIR"

RED='\033[0;31m'
YELLOW='\033[0;33m'
PLAIN='\033[0m'

ARGS=(--changed)
if git rev-parse --verify '@{u}' >/dev/null 2>&1; then
    ARGS+=(--base '@{u}')
elif git rev-parse --verify 'HEAD~1' >/dev/null 2>&1; then
    ARGS+=(--base 'HEAD~1')
fi

if [ ! -x "./scripts/verify.sh" ]; then
    echo -e "${RED}❌ [Pre-push] scripts/verify.sh missing or not executable${PLAIN}" >&2
    exit 1
fi

if ! ./scripts/verify.sh "${ARGS[@]}"; then
    echo -e "\n${RED}❌ [Pre-push 拦截] 质量门禁未通过，请先修复后重试。${PLAIN}"
    echo -e "${YELLOW}💡 紧急跳过可使用: git push --no-verify${PLAIN}\n"
    exit 1
fi

exit 0
